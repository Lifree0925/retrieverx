# ============================================================
# RetrieverX 配置示例：复制为 .env 后按需修改
#   Windows: copy .env.example .env
#   Linux:   cp .env.example .env
# ============================================================

# ---------- 基础信息 ----------
APP_NAME=RetrieverX
APP_ENV=development
LOG_LEVEL=INFO

# ---------- Embedding（OpenAI 兼容接口）----------
# 国内可用硅基流动 / 智谱 / 通义等。例（硅基流动）：
#   EMBEDDING_MODEL=BAAI/bge-m3
#   EMBEDDING_DIM=1024
#   EMBEDDING_API_KEY=sk-xxx
#   EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
#
# 【用 Ollama 本地跑（零成本，推荐）】
#   ollama pull bge-m3
#   EMBEDDING_MODEL=bge-m3
#   EMBEDDING_DIM=1024
#   EMBEDDING_API_KEY=ollama
#   EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
#
# ⚠️ 中文检索务必用【多语言/中文】模型。
#    nomic-embed-text 是英文向模型，中文语义检索明显偏弱：
#    实测同一份中文语料的 Top-1 准确率只有 4/8，换成 bge-m3 后是 7/8。
#    可选：bge-m3（多语言，1024 维，1.2GB）、quentinz/bge-large-zh（纯中文，1024 维）
#
# ⚠️ 换模型必须同步改 EMBEDDING_DIM 并重建索引（向量维度变了）：
#      python scripts/index_documents.py xxx.pdf --reset
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024
EMBEDDING_API_KEY=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1

# ---------- 依赖服务地址 ----------
# 本机直跑（用 docker compose 只起中间件）：
QDRANT_URL=http://localhost:6333
ELASTICSEARCH_URL=http://localhost:9200
REDIS_URL=redis://localhost:6379/0
# 全部容器化（docker compose up 全家桶）时改为容器名：
# QDRANT_URL=http://qdrant:6333
# ELASTICSEARCH_URL=http://elasticsearch:9200
# REDIS_URL=redis://redis:6379/0
QDRANT_COLLECTION=retrieverx_chunks
ELASTICSEARCH_INDEX=retrieverx_chunks
FEEDBACK_TTL=2592000

# ---------- Reranker（精排，可选）----------
# 新手建议先 RERANK_ENABLE=false 跑通主链路，再开启精排
# （开启前建议先跑 python scripts/download_models.py 预下载模型）
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_ENABLE=false
# 单次【打分】超时上限。本机 CPU 实测 20 个候选约 16 秒，
# 给太小会导致每次都超时降级。CPU 环境建议 30。
RERANK_TIMEOUT_SECONDS=30
# 模型【加载/下载】的等待上限（一次性，与打分超时分开算）
RERANK_LOAD_TIMEOUT_SECONDS=90
# 每对 (query, doc) 截断到的最大 token 数，直接决定打分速度
# （CPU 上 512 → 20 条约 16 秒；256 约快一倍）
RERANKER_MAX_LENGTH=512
# cpu / cuda / 留空=自动选择
RERANKER_DEVICE=

# ---------- HuggingFace 下载源 ----------
# 国内直连 huggingface.co 基本不通，首次加载模型会长时间卡住（典型症状：提问超时）。
# 配成国内镜像即可；留空则走官方源。
HF_ENDPOINT=https://hf-mirror.com

# ---------- 检索参数 ----------
DEFAULT_TOP_K=5
RECALL_TOP_K=20
RRF_K=60
BM25_WEIGHT=0.5
VECTOR_WEIGHT=0.5
CONFIDENCE_THRESHOLD=0.5

# ---------- 策略自适应约束 ----------
POLICY_MIN_SAMPLES=20
POLICY_WINDOW_SIZE=100
POLICY_MAX_STEP=0.1
